# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AIVEN.IO MYSQL DATABASE CONFIGURATION
# Cách 1: Sử dụng Service URI trực tiếp từ Aiven.io Console:
# Ví dụ: mysql://avnadmin:AVNS_xxxx@mysql-project-xxxx.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
MYSQL_URI="mysql://avnadmin:your_password@your_host.aivencloud.com:port/defaultdb?ssl-mode=REQUIRED"

# Cách 2: Hoặc cấu hình từng thông số chi tiết:
MYSQL_HOST="mysql-project-xxxx.aivencloud.com"
MYSQL_PORT="12345"
MYSQL_USER="avnadmin"
MYSQL_PASSWORD="your_aiven_password"
MYSQL_DATABASE="defaultdb"
MYSQL_SSL="true"
